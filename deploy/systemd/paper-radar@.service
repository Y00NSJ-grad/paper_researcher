[Unit]
Description=Paper Radar %i job
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/widget/paper-search
EnvironmentFile=-%h/widget/paper-search/.env
ExecStart=/usr/bin/flock -n %h/widget/paper-search/data/job.lock %h/widget/paper-search/.venv/bin/paper-radar %i
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
